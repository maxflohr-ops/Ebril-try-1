# ---------------------------------------------------------------------------
# TikTok app credentials — https://developers.tiktok.com/apps
# Create an app, add the "Login Kit" and "Display API" products, then copy the
# Client key / Client secret from the app's Basic information page.
# ---------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Must match a Redirect URI registered on the TikTok app, character for
# character (including the port). TikTok requires HTTPS for live apps, so for
# local development either register a sandbox redirect or point a tunnel
# (cloudflared / ngrok) at this server and use the tunnel URL here.
TIKTOK_REDIRECT_URI=http://localhost:8787/oauth/callback

# Scopes requested from each fan page. user.info.stats is what unlocks
# follower_count; video.list is what unlocks per-video view/like/comment/share
# counts. Both usually need app review before non-sandbox users can grant them.
TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list

# Optional: Research API fallback for pages that have not authorized you.
# Requires a separate, approved TikTok Research API application.
TIKTOK_RESEARCH_ENABLED=false

# ---------------------------------------------------------------------------
# Local settings
# ---------------------------------------------------------------------------
PORT=8787
DB_PATH=./data/tracker.db
SYNC_VIDEO_LIMIT=60
