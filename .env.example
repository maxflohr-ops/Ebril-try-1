DATABASE_URL=postgresql://user:password@localhost:5432/ebril

APP_BASE_URL=http://localhost:3000

PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_WEBHOOK_SECRET=

# Must be at least 32 chars in production
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Comma-separated Patreon user ids with admin access
ADMIN_PATREON_IDS=

# Shared secret for POST/GET to /api/cron/*
CRON_SECRET=

# Transactional email (optional; no-ops and logs if unset)
RESEND_API_KEY=
EMAIL_FROM="Ebril Rewards <rewards@ebril.app>"

# Web Push (optional; pushes no-op and log if unset). Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:rewards@ebril.app

# Stripe (required for point packs and cash reward purchases)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shopify Storefront API (optional; /shop renders the empty-state without these)
# Storefront access token is read-only and safe to ship — it cannot modify the store.
SHOPIFY_STORE_DOMAIN=shop.ebril.com
SHOPIFY_STOREFRONT_TOKEN=
