DATABASE_URL=postgresql://user:password@localhost:5432/ebril

APP_BASE_URL=http://localhost:3000

PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_WEBHOOK_SECRET=

# Must be at least 32 chars in production
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Comma-separated Patreon user ids with admin access
ADMIN_PATREON_IDS=

# Shared secret for POST/GET to /api/cron/*
CRON_SECRET=

# Transactional email (optional; no-ops and logs if unset)
RESEND_API_KEY=
EMAIL_FROM="Ebril Rewards <rewards@ebril.app>"

# Web Push (optional; pushes no-op and log if unset). Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:rewards@ebril.app

# Microsoft Azure app registration — powers "sign in with microsoft" so
# fans can auto-link Minecraft Java without typing a pairing code.
# Register at https://portal.azure.com → App registrations.
# Redirect URI: ${APP_BASE_URL}/api/auth/minecraft-ms/callback
# Scopes: XboxLive.signin offline_access
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Discord application — powers "sign in with discord" so fans can link
# their discord identity for tier roles and server announcements.
# Register at https://discord.com/developers/applications.
# Redirect URI: ${APP_BASE_URL}/api/auth/discord/callback
# Scope: identify
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord tier-role sync (optional; no-ops when unset). Add a bot to the
# same Discord application, invite it to Ebril's server with the
# MANAGE_ROLES permission, and put the bot *above* the managed roles in
# the server role list. Then fill in the guild + role ids (turn on
# Developer Mode in Discord → right-click → Copy ID).
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_UNRANKED=
DISCORD_ROLE_FAN=
DISCORD_ROLE_SUPERFAN=
DISCORD_ROLE_VIP=

# Stripe (required for point packs and cash reward purchases)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shopify Storefront API (optional; /shop renders the empty-state without these)
# Storefront access token is read-only and safe to ship — it cannot modify the store.
SHOPIFY_STORE_DOMAIN=shop.ebril.com
SHOPIFY_STOREFRONT_TOKEN=

# Sentry (optional; all init code no-ops when unset)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENV=
NEXT_PUBLIC_SENTRY_ENV=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# At-rest encryption for Patreon access/refresh tokens. Generate 32 bytes:
#   openssl rand -base64 32   (or)   openssl rand -hex 32
# When unset the app falls through to plaintext storage (dev convenience).
# In production this should always be set — without it a DB leak is full
# Patreon account takeover for every fan. Legacy plaintext rows remain
# readable after you turn encryption on; they're re-encrypted the next time
# the token refreshes.
ENCRYPTION_KEY=

# Demo mode. When "1", /demo renders a card-picker of seeded fake fans and
# /api/demo/sign-in bypasses Patreon OAuth to write the chosen userId into
# the session. A yellow "DEMO MODE" banner pins to the top of every page.
# NEVER set this in production — it's an intentional auth bypass for
# local demos. See docs/demo.md for the walkthrough.
DEMO_MODE=

# Minecraft ↔ copula plugin integration. Shared secret the server plugin
# uses to HMAC-sign its requests; when unset every /api/minecraft/*
# endpoint returns 503 missing_secret. Generate with:
#   openssl rand -hex 32
# See docs/minecraft-integration.md for the full plugin contract.
MINECRAFT_SHARED_SECRET=
