generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  patreonUserId       String   @unique
  email               String?
  displayName         String?
  avatarUrl           String?
  dob                 DateTime?
  patreonAccessToken  String?
  patreonRefreshToken String?
  patreonTokenExpires DateTime?
  currentTierId       String?
  currentTier         Tier?    @relation(fields: [currentTierId], references: [id])
  referralCode        String   @unique @default(cuid())
  referredById        String?
  referredBy          User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals           User[]   @relation("Referrals")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  pledges      Pledge[]
  transactions PointTransaction[]
  redemptions  Redemption[]

  @@index([currentTierId])
  @@index([referredById])
}

model Pledge {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  patreonPledgeId  String       @unique
  amountCents      Int
  currency         String       @default("USD")
  status           PledgeStatus
  startedAt        DateTime
  lastChargedAt    DateTime?
  updatedAt        DateTime     @updatedAt

  @@index([userId])
}

enum PledgeStatus {
  active
  paused
  declined
  cancelled
}

model PointTransaction {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    TransactionReason
  refId     String?
  expiresAt DateTime?
  createdAt DateTime          @default(now())

  @@index([userId])
  @@index([userId, expiresAt])
}

enum TransactionReason {
  pledge_charge
  campaign_bonus
  birthday
  referral
  streak
  manual_adjust
  redemption
  expiry
  signup_bonus
  stripe_top_up
  diary_entry
  ritual_claim
}

model Tier {
  id                    String @id @default(uuid())
  name                  String @unique
  sortOrder             Int    @unique
  thresholdCentsPerMonth Int
  multiplier            Float  @default(1.0)
  perks                 Json   @default("[]")

  users      User[]
  rewards    Reward[]
  voiceNotes VoiceNote[] @relation("VoiceNoteTier")
}

model Campaign {
  id          String   @id @default(uuid())
  name        String
  multiplier  Float    @default(1.0)
  flatBonus   Int?
  startsAt    DateTime
  endsAt      DateTime
  tierFilter  Json?
  createdAt   DateTime @default(now())

  @@index([startsAt, endsAt])
}

model Reward {
  id             String     @id @default(uuid())
  name           String
  description    String
  imageUrl       String?
  costPoints     Int
  cashPriceCents Int?
  stock          Int?
  tierRequiredId String?
  tierRequired   Tier?      @relation(fields: [tierRequiredId], references: [id])
  type           RewardType
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())

  redemptions Redemption[]
}

model PointPack {
  id          String   @id @default(uuid())
  name        String
  points      Int
  priceCents  Int
  currency    String   @default("USD")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([active, sortOrder])
}

model StripeCheckout {
  id              String   @id @default(uuid())
  userId          String
  sessionId       String   @unique
  kind            String
  targetId        String?
  amountCents     Int
  pointsDelta     Int?
  status          String   @default("pending")
  fulfilledAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([status])
}

enum RewardType {
  merch
  signed
  call_1on1
  content_unlock
  discount_code
}

model Redemption {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId         String
  reward           Reward           @relation(fields: [rewardId], references: [id])
  costPoints       Int
  status           RedemptionStatus @default(pending)
  shippingAddress  Json?
  fulfillmentNotes String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId])
  @@index([status])
}

enum RedemptionStatus {
  pending
  approved
  shipped
  delivered
  cancelled
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  targetId  String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}

model WebhookEvent {
  id         String   @id @default(uuid())
  source     String
  externalId String   @unique
  payload    Json
  receivedAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId, createdAt])
}

model DiaryEntry {
  id              String    @id @default(uuid())
  userId          String
  text            String
  mood            DiaryMood
  trackTitle      String?
  trackUrl        String?
  sharedWithEbril Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([sharedWithEbril, createdAt])
}

enum DiaryMood {
  dusk
  dawn
  aching
  open
  alone
  together
  threeam
  commute
}

model Ritual {
  id            String    @id @default(uuid())
  title         String
  body          String
  trackTitle    String?
  trackUrl      String?
  artworkUrl    String?
  startsAt      DateTime
  endsAt        DateTime
  pointsReward  Int       @default(25)
  createdAt     DateTime  @default(now())

  claims RitualClaim[]

  @@index([startsAt, endsAt])
}

model RitualClaim {
  id        String   @id @default(uuid())
  userId    String
  ritualId  String
  ritual    Ritual   @relation(fields: [ritualId], references: [id], onDelete: Cascade)
  reflection String?
  claimedAt DateTime @default(now())

  @@unique([userId, ritualId])
  @@index([ritualId])
}

model ExternalLink {
  id         String     @id @default(uuid())
  kind       LinkKind
  label      String
  url        String
  extra      Json?
  sortOrder  Int        @default(0)
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([kind, active])
}

enum LinkKind {
  spotify_artist
  spotify_featured
  youtube_channel
  youtube_featured
  apple_music
  shopify_store
  bandcamp
  soundcloud
  instagram
  tiktok
  discord
  website
}

model Collectible {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  flavor      String
  tapeColor   String  @default("#D89B7A")
  labelColor  String  @default("#F4ECE2")
  rarity      CollectibleRarity @default(common)
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())

  grants CollectibleGrant[]
}

enum CollectibleRarity {
  common
  rare
  vip
  ephemeral
}

model CollectibleGrant {
  id            String      @id @default(uuid())
  userId        String
  collectibleId String
  collectible   Collectible @relation(fields: [collectibleId], references: [id], onDelete: Cascade)
  reason        String?
  grantedAt     DateTime    @default(now())

  @@unique([userId, collectibleId])
  @@index([userId])
  @@index([collectibleId])
}

model VoiceNote {
  id             String   @id @default(uuid())
  title          String
  caption        String
  audioUrl       String
  durationSec    Int
  tierRequiredId String?
  tierRequired   Tier?    @relation("VoiceNoteTier", fields: [tierRequiredId], references: [id])
  publishedAt    DateTime @default(now())
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  listens VoiceNoteListen[]

  @@index([active, publishedAt])
}

model VoiceNoteListen {
  id              String    @id @default(uuid())
  userId          String
  voiceNoteId     String
  voiceNote       VoiceNote @relation(fields: [voiceNoteId], references: [id], onDelete: Cascade)
  secondsListened Int       @default(0)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, voiceNoteId])
  @@index([voiceNoteId])
}

model TourDate {
  id            String   @id @default(uuid())
  city          String
  venue         String
  country       String   @default("CA")
  startsAt      DateTime
  doorsAt       DateTime?
  ticketUrl     String?
  noteFromEbril String?
  qrSecret      String   @default(cuid())
  pointsReward  Int      @default(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  checkins TourCheckin[]

  @@index([startsAt])
}

model TourCheckin {
  id         String   @id @default(uuid())
  userId     String
  tourDateId String
  tourDate   TourDate @relation(fields: [tourDateId], references: [id], onDelete: Cascade)
  message    String?
  checkedAt  DateTime @default(now())

  @@unique([userId, tourDateId])
  @@index([tourDateId])
}
